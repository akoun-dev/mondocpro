/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets — jamais versionnés) ; .env.example = modèle versionné
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# database (jamais versionnée)
db/
*.db

# état local CLI Supabase (non versionné)
supabase/.temp/

# artefacts d'outillage AI (captures E2E, sorties d'outils — régénérables,
# preuves E2E conservées en local uniquement ; cf. worklog Tasks 23-24)
tool-results/

# natif Android — Capacitor (Task 36)
android/app/google-services.json
*.keystore
*.jks
.android-sdk/
.jdk21/
# Exception volontaire (Task 38) : keystore DEBUG versionné — signature
# stable des APK de test d'un build à l'autre (mises à jour installables
# par-dessus sans désinstallation). Ne JAMAIS y placer un keystore release.
!android/keys/debug.keystore
