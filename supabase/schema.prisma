// Schéma Mon doc Pro — FEATURE-AUTH (ADR-004)
// Identifiant métier = téléphone (unique) · sessions serveur en DB (traçabilité)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Rôles applicatifs — miroir des acteurs du cahier des charges
enum Role {
  PATIENT
  NURSE
  ADMIN
}

// Préférence de thème — FEATURE-DARK-MODE (Task 37).
// SYSTEM : suit le réglage de l'appareil (prefers-color-scheme) ; LIGHT/DARK :
// choix explicite de l'utilisateur, persisté en base (pour chaque utilisateur).
enum ThemeMode {
  SYSTEM
  LIGHT
  DARK
}

// Zones de couverture (liste fermée définie par le PO)
enum Zone {
  YOPOUGON
  SONGON
  PK22
  NDOTRE
}

model User {
  id                  String               @id @default(cuid())
  fullName            String
  phone               String               @unique
  passwordHash        String
  role                Role                 @default(PATIENT)
  zone                Zone
  // ——— FEATURE-PROFIL — édition du profil + préférences notifications ———
  // birthDate : renseignée via PATCH /api/auth/profile (date UTC à minuit) ;
  // appointmentReminders / healthAlerts : toggles « Préférences & Alertes »
  // de la vue Profil (rappels RDV 24 h avant · alertes de santé locales).
  birthDate             DateTime?
  appointmentReminders  Boolean              @default(true)
  healthAlerts          Boolean              @default(true)
  // FEATURE-DARK-MODE (Task 37) : thème préféré de CET utilisateur, éditable
  // via PATCH /api/auth/profile (toggle en-tête + section « Apparence » du
  // profil) et appliqué par ThemeInit (boot localStorage puis sync serveur).
  theme                 ThemeMode            @default(SYSTEM)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  appointments        Appointment[]
  notifications       Notification[]
  deviceTokens        DeviceToken[]
  tokenTransactions   TokenTransaction[]
  updatedTariffs      TariffConfig[]
  nurseMissions       NurseMission[]       @relation("NurseMissions")
  patientMissions     NurseMission[]       @relation("PatientMissions")
  assignedMissions    NurseMission[]       @relation("AssignedBy")
  visitReports        VisitReport[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// Jetons de réinitialisation de mot de passe (US-AUTH-5).
// Seul le SHA-256 du code à 6 chiffres est stocké (même principe que les sessions) :
// expiration 15 min, usage unique (usedAt), anciens jetons purgés à chaque demande.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ——— FEATURE-RDV — Rendez-vous cabinet / domicile ———

enum AppointmentType {
  CABINET
  DOMICILE
}

enum AppointmentStatus {
  PENDING // en attente de confirmation par l'équipe (défaut à la création)
  CONFIRMED // confirmé par l'équipe
  CANCELLED // annulé (patient ou équipe)
  DONE // consultation réalisée
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  patient     User              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  // Spécialité demandée (FEATURE-RDV wizard étape 2) — configurable par
  // l'ADMIN. Nullable pour les RDV créés avant la feature (backfill seed).
  specialtyId String?
  specialty   Specialty?        @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  type        AppointmentType
  zone        Zone
  // Créneau aligné sur la grille de 30 min (Afrique/Abidjan = UTC+0 sans
  // heure d'été : l'heure locale est l'heure UTC).
  scheduledAt DateTime
  status      AppointmentStatus @default(PENDING)
  reason      String?           @db.VarChar(500)
  notes       String?           @db.VarChar(1000)
  cancelledAt DateTime?
  // Rappel « 24 h avant RDV » déjà envoyé — anti-doublon du scheduler
  // (FEATURE-RDV). Canal SMS provider-agnostic tant que la décision A10
  // (choix de la passerelle) est ouverte.
  reminderSentAt DateTime?
  // ——— FEATURE-TOKENS (ADR-007) — cycle financier de la consultation ———
  // tokenState suit la vie de la réservation de Tokens : NONE (RDV
  // antérieurs aux Tokens / hors périmètre) → RESERVED (à la demande) →
  // CONSUMED (visite réalisée = dépense définitive) ou RELEASED (annulation
  // / équipe non trouvée = libération). tokensReserved : nombre de Tokens
  // bloqués à la création (tarif provisionnel — ADR-007 §tarifs).
  tokenState    AppointmentTokenState @default(NONE)
  tokensReserved Int                 @default(0)
  // Mouvements de Tokens liés à ce RDV (réservation/consommation/libération).
  tokenTransactions TokenTransaction[]
  nurseMission NurseMission?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([patientId])
  @@index([scheduledAt])
  @@index([specialtyId])
  @@map("appointments")
}

// Cycle de vie des Tokens d'un RDV (ADR-007) — NONE couvre les RDV créés
// avant la feature (et un futur RDV sans facturation).
enum AppointmentTokenState {
  NONE
  RESERVED
  CONSUMED
  RELEASED
}

// ——— FEATURE-RDV — Spécialités de consultation (configurables ADMIN) ———
// Catalogue géré par le Médecin Chef (POST/PATCH/DELETE admin) ; les patients
// choisissent parmi les spécialités actives (wizard étape 2).
model Specialty {
  id           String        @id @default(cuid())
  name         String        @unique @db.VarChar(80)
  // Désactivation douce : masquée aux patients, conservée pour l'historique.
  isActive     Boolean       @default(true)
  // Ordre d'affichage dans le wizard (ascendant, puis nom).
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@map("specialties")
}

// ——— FEATURE-SENSO — Sensibilisations santé ———

enum SensibilisationCategory {
  ADVICE
  ALERT
}

model Sensibilisation {
  id          String                  @id @default(cuid())
  title       String                  @db.VarChar(120)
  body        String                  @db.Text
  category    SensibilisationCategory @default(ADVICE)
  // Zones ciblées — liste vide = visible depuis toutes les zones.
  zones       Zone[]
  publishedAt DateTime                @default(now())
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([publishedAt])
  @@map("sensibilisations")
}

// ——— FEATURE-TOKENS (ADR-007) — Portefeuille de Tokens (crédits prépayés) ———
// 1 Token = 2 500 FCFA (valeur fixée par le document de présentation).
// Ledger APPEND-ONLY : chaque mouvement financier est une ligne immuable —
// le solde est TOUJOURS recalculé (aucun champ solde modifiable), seule la
// transition de statut d'une recharge PENDING est une mutation autorisée
// (garde updateMany : une double confirmation reste sans effet).
enum TokenTransactionType {
  RECHARGE      // +N — recharge validée (paiement externe Wave/OM/MTN/Visa)
  RESERVATION   // +N — blocage à la demande de RDV (déduit du disponible)
  CONSUMPTION   // +N — clôture de la réservation en dépense définitive (solde inchangé)
  RELEASE       // +N — libération d'une réservation (annulation / non trouvée)
  REFUND        // +N — remboursement au patient (24 décembre, geste commercial)
  ADJUSTMENT    // ±N — correction manuelle du Médecin Chef (anomalie)
}

enum TokenTransactionStatus {
  PENDING   // recharge déclarée, en attente de validation du Médecin Chef
  CONFIRMED // mouvement effectif (comptabilisé dans le solde)
  REJECTED  // recharge refusée (paiement non rapproché) — jamais comptabilisée
}

model TokenTransaction {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenTransactionType
  status    TokenTransactionStatus @default(CONFIRMED)
  // Nombre de Tokens du mouvement (positif ; ADJUSTMENT peut être négatif).
  // Effet sur le disponible : RECHARGE/RELEASE/REFUND +N · RESERVATION −N ·
  // CONSUMPTION 0 (la réservation avait déjà déduit) · ADJUSTMENT signé.
  tokens     Int
  // Équivalent FCFA du mouvement (recharges, consommations, remboursements).
  amountFcfa Int?
  // Référence prestataire de paiement (Wave/OM/MTN/Visa) — remplie quand la
  // décision Mobile Money (ADR-005) sera tranchée ; antichambre à la
  // déduplication des confirmations prestataires.
  providerRef String?
  // RDV lié (réservation / consommation / libération) — SetNull : le ledger
  // survit à une purge éventuelle du RDV (traçabilité financière).
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  // Réservation source d'une CONSUMPTION / RELEASE (chaînage auditable).
  relatedTransactionId String?
  // Note libre (motif de refus, libellé d'ajustement, preuve remboursement…).
  note        String?  @db.VarChar(300)
  // ADMIN ayant traité la recharge (confirmée/refusée) ou clôturé le RDV.
  processedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, type, status])
  @@index([appointmentId])
  @@map("token_transactions")
}

// ——— FEATURE-RDV / Task 24 — Notifications InApp ———
// Centre de notifications in-app : le canal qui fonctionne dès aujourd'hui
// (vs SMS en attente de la décision A10, ADR-006). Task 35 — couverture
// complète des cycles métier :
//   - rappels « 24 h avant RDV » (scheduler, reminders.ts) ;
//   - cycle missions infirmières (nurse.ts : affectation, statut, CR) ;
//   - cycle recharges de Tokens (tokens.ts : déclaration patient → décision
//     Médecin Chef) — le patient est informé du crédit/refus, l'ADMIN est
//     alerté des paiements à rapprocher ;
//   - cycle RDV (appointments.ts : demande à domicile à affecter pour
//     l'ADMIN, annulation patient → ADMIN, clôture/annulation ADMIN → patient).
enum NotificationType {
  APPOINTMENT_REMINDER
  MISSION_ASSIGNED
  MISSION_STATUS_CHANGED
  VISIT_REPORT_SUBMITTED
  RECHARGE_REQUESTED
  RECHARGE_CONFIRMED
  RECHARGE_REJECTED
  APPOINTMENT_REQUESTED
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  title  String           @db.VarChar(120)
  body   String           @db.VarChar(500)
  // Entité source optionnelle (ex: appointmentId) — sert d'anti-doublon
  // structurel via @@unique (un même RDV ne produit jamais 2 rappels InApp,
  // même si le canal SMS échoue et est retenté) et de contexte de navigation.
  entityId String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Anti-doublon : (user, type, entité source) unique. NB Postgres : les NULL
  // sont distincts dans un index unique → la déduplication ne vaut que pour
  // les types portant une entityId (cas du rappel RDV).
  @@unique([userId, type, entityId])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ——— FEATURE-NURSE — Missions de soins à domicile ———
enum MissionStatus {
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model NurseMission {
  id             String        @id @default(cuid())
  appointmentId  String        @unique
  appointment    Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  nurseId        String
  nurse          User          @relation("NurseMissions", fields: [nurseId], references: [id], onDelete: Restrict)
  patientId      String
  patient        User          @relation("PatientMissions", fields: [patientId], references: [id], onDelete: Restrict)
  assignedById   String
  assignedBy     User          @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  status         MissionStatus @default(ASSIGNED)
  assignedAt     DateTime      @default(now())
  acceptedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  visitReport    VisitReport?

  @@index([nurseId, status, assignedAt])
  @@index([patientId, assignedAt])
  @@map("nurse_missions")
}

model VisitReport {
  id             String       @id @default(cuid())
  missionId      String       @unique
  mission        NurseMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  nurseId        String
  nurse          User         @relation(fields: [nurseId], references: [id], onDelete: Restrict)
  observations   String       @db.Text
  actionsTaken   String?      @db.Text
  recommendations String?     @db.Text
  vitalSigns     Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([nurseId, createdAt])
  @@map("visit_reports")
}

// ——— FEATURE-PUSH / ADR-010 — Identifiants d'appareils natifs ———
// Deux populations : jetons FCM dormants (ADR-009, jamais alimentés) et
// clés de sondage du Background Runner (ADR-010). Stockage HASHÉ (SHA-256)
// : la clé autorise à LIRE les notifications de l'utilisateur, une fuite DB
// ne doit donc pas la compromettre. Suppression à la déconnexion
// (POST /api/push/unregister) et à la réinitialisation de mot de passe.
// lastSeenAt trace l'activité : un appareil vu depuis > 90 jours pourra être
// purgé par une future tâche d'entretien.
model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Empreinte SHA-256 de l'identifiant d'appareil. Depuis l'ADR-010, la table
  // porte deux populations : les jetons FCM dormants (jamais alimentés) et
  // les CLÉS DE SONDAGE du Background Runner — un identifiant d'appareil est
  // un secret d'authentification (il autorise à LIRE les notifications), seul
  // son hash est donc stocké (même posture que Session.tokenHash).
  token      String   @unique @db.VarChar(4096)
  // "android" | "ios" | "web" — Device.platform (Capacitor).
  platform   String   @db.VarChar(20)
  deviceName String?  @db.VarChar(120)
  appVersion String?  @db.VarChar(40)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now()) @updatedAt
  // Expiration des clés de sondage (ADR-010) — null = jeton FCM historique
  // sans TTL. Une clé expirée ne peut plus lire /api/notifications/poll.
  expiresAt  DateTime?

  @@index([userId])
  @@map("device_tokens")
}

// ——— FEATURE-TOKENS (ADR-007) — Grille tarifaire configurable par l'ADMIN ———
// Une ligne par poste tarifaire (clé métier → prix en Tokens). Le Médecin
// Chef édite les prix depuis son dashboard ; le coût d'un RDV est FIGÉ à la
// création (appointments.tokensReserved) : modifier un tarif ne vaut que
// pour les demandes à venir. Design extensible — une future ligne (frais
// patient absent, majoration nuit/week-end…) = un INSERT, sans migration.
// Clés v1 : CONSULTATION_CABINET · CONSULTATION_DOMICILE (libellés FR et
// garde-fous 0..100 Tokens : src/lib/token-schemas.ts, source unique).
model TariffConfig {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(60)
  tokens      Int
  // Dernier ADMIN ayant modifié ce tarif (audit) — SetNull : la ligne
  // survit à une suppression éventuelle du compte.
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tariff_configs")
}
