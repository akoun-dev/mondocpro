// Schéma Mon doc Pro — FEATURE-AUTH (ADR-004)
// Identifiant métier = téléphone (unique) · sessions serveur en DB (traçabilité)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Rôles applicatifs — miroir des acteurs du cahier des charges
enum Role {
  PATIENT
  NURSE
  ADMIN
}

// Zones de couverture (liste fermée définie par le PO)
enum Zone {
  YOPOUGON
  SONGON
  PK22
  NDOTRE
}

model User {
  id                  String               @id @default(cuid())
  fullName            String
  phone               String               @unique
  passwordHash        String
  role                Role                 @default(PATIENT)
  zone                Zone
  // ——— FEATURE-PROFIL — édition du profil + préférences notifications ———
  // birthDate : renseignée via PATCH /api/auth/profile (date UTC à minuit) ;
  // appointmentReminders / healthAlerts : toggles « Préférences & Alertes »
  // de la vue Profil (rappels RDV 24 h avant · alertes de santé locales).
  birthDate             DateTime?
  appointmentReminders  Boolean              @default(true)
  healthAlerts          Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  appointments        Appointment[]
  notifications       Notification[]
  tokenTransactions   TokenTransaction[]
  updatedTariffs      TariffConfig[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// Jetons de réinitialisation de mot de passe (US-AUTH-5).
// Seul le SHA-256 du code à 6 chiffres est stocké (même principe que les sessions) :
// expiration 15 min, usage unique (usedAt), anciens jetons purgés à chaque demande.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ——— FEATURE-RDV — Rendez-vous cabinet / domicile ———

enum AppointmentType {
  CABINET
  DOMICILE
}

enum AppointmentStatus {
  PENDING // en attente de confirmation par l'équipe (défaut à la création)
  CONFIRMED // confirmé par l'équipe
  CANCELLED // annulé (patient ou équipe)
  DONE // consultation réalisée
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  patient     User              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  // Spécialité demandée (FEATURE-RDV wizard étape 2) — configurable par
  // l'ADMIN. Nullable pour les RDV créés avant la feature (backfill seed).
  specialtyId String?
  specialty   Specialty?        @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  type        AppointmentType
  zone        Zone
  // Créneau aligné sur la grille de 30 min (Afrique/Abidjan = UTC+0 sans
  // heure d'été : l'heure locale est l'heure UTC).
  scheduledAt DateTime
  status      AppointmentStatus @default(PENDING)
  reason      String?           @db.VarChar(500)
  notes       String?           @db.VarChar(1000)
  cancelledAt DateTime?
  // Rappel « 24 h avant RDV » déjà envoyé — anti-doublon du scheduler
  // (FEATURE-RDV). Canal SMS provider-agnostic tant que la décision A10
  // (choix de la passerelle) est ouverte.
  reminderSentAt DateTime?
  // ——— FEATURE-TOKENS (ADR-007) — cycle financier de la consultation ———
  // tokenState suit la vie de la réservation de Tokens : NONE (RDV
  // antérieurs aux Tokens / hors périmètre) → RESERVED (à la demande) →
  // CONSUMED (visite réalisée = dépense définitive) ou RELEASED (annulation
  // / équipe non trouvée = libération). tokensReserved : nombre de Tokens
  // bloqués à la création (tarif provisionnel — ADR-007 §tarifs).
  tokenState    AppointmentTokenState @default(NONE)
  tokensReserved Int                 @default(0)
  // Mouvements de Tokens liés à ce RDV (réservation/consommation/libération).
  tokenTransactions TokenTransaction[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([patientId])
  @@index([scheduledAt])
  @@index([specialtyId])
  @@map("appointments")
}

// Cycle de vie des Tokens d'un RDV (ADR-007) — NONE couvre les RDV créés
// avant la feature (et un futur RDV sans facturation).
enum AppointmentTokenState {
  NONE
  RESERVED
  CONSUMED
  RELEASED
}

// ——— FEATURE-RDV — Spécialités de consultation (configurables ADMIN) ———
// Catalogue géré par le Médecin Chef (POST/PATCH/DELETE admin) ; les patients
// choisissent parmi les spécialités actives (wizard étape 2).
model Specialty {
  id           String        @id @default(cuid())
  name         String        @unique @db.VarChar(80)
  // Désactivation douce : masquée aux patients, conservée pour l'historique.
  isActive     Boolean       @default(true)
  // Ordre d'affichage dans le wizard (ascendant, puis nom).
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@map("specialties")
}

// ——— FEATURE-SENSO — Sensibilisations santé ———

enum SensibilisationCategory {
  ADVICE
  ALERT
}

model Sensibilisation {
  id          String                  @id @default(cuid())
  title       String                  @db.VarChar(120)
  body        String                  @db.Text
  category    SensibilisationCategory @default(ADVICE)
  // Zones ciblées — liste vide = visible depuis toutes les zones.
  zones       Zone[]
  publishedAt DateTime                @default(now())
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([publishedAt])
  @@map("sensibilisations")
}

// ——— FEATURE-TOKENS (ADR-007) — Portefeuille de Tokens (crédits prépayés) ———
// 1 Token = 2 500 FCFA (valeur fixée par le document de présentation).
// Ledger APPEND-ONLY : chaque mouvement financier est une ligne immuable —
// le solde est TOUJOURS recalculé (aucun champ solde modifiable), seule la
// transition de statut d'une recharge PENDING est une mutation autorisée
// (garde updateMany : une double confirmation reste sans effet).
enum TokenTransactionType {
  RECHARGE      // +N — recharge validée (paiement externe Wave/OM/MTN/Visa)
  RESERVATION   // +N — blocage à la demande de RDV (déduit du disponible)
  CONSUMPTION   // +N — clôture de la réservation en dépense définitive (solde inchangé)
  RELEASE       // +N — libération d'une réservation (annulation / non trouvée)
  REFUND        // +N — remboursement au patient (24 décembre, geste commercial)
  ADJUSTMENT    // ±N — correction manuelle du Médecin Chef (anomalie)
}

enum TokenTransactionStatus {
  PENDING   // recharge déclarée, en attente de validation du Médecin Chef
  CONFIRMED // mouvement effectif (comptabilisé dans le solde)
  REJECTED  // recharge refusée (paiement non rapproché) — jamais comptabilisée
}

model TokenTransaction {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenTransactionType
  status    TokenTransactionStatus @default(CONFIRMED)
  // Nombre de Tokens du mouvement (positif ; ADJUSTMENT peut être négatif).
  // Effet sur le disponible : RECHARGE/RELEASE/REFUND +N · RESERVATION −N ·
  // CONSUMPTION 0 (la réservation avait déjà déduit) · ADJUSTMENT signé.
  tokens     Int
  // Équivalent FCFA du mouvement (recharges, consommations, remboursements).
  amountFcfa Int?
  // Référence prestataire de paiement (Wave/OM/MTN/Visa) — remplie quand la
  // décision Mobile Money (ADR-005) sera tranchée ; antichambre à la
  // déduplication des confirmations prestataires.
  providerRef String?
  // RDV lié (réservation / consommation / libération) — SetNull : le ledger
  // survit à une purge éventuelle du RDV (traçabilité financière).
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  // Réservation source d'une CONSUMPTION / RELEASE (chaînage auditable).
  relatedTransactionId String?
  // Note libre (motif de refus, libellé d'ajustement, preuve remboursement…).
  note        String?  @db.VarChar(300)
  // ADMIN ayant traité la recharge (confirmée/refusée) ou clôturé le RDV.
  processedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, type, status])
  @@index([appointmentId])
  @@map("token_transactions")
}

// ——— FEATURE-RDV / Task 24 — Notifications InApp ———
// Centre de notifications in-app du patient : le canal qui fonctionne dès
// aujourd'hui (vs SMS en attente de la décision A10, ADR-006). Premier type
// câblé : rappel « 24 h avant RDV » créé par le scheduler (src/lib/reminders.ts).
// Future extension naturelle : alertes de santé locales (healthAlerts),
// confirmation/annulation de RDV — l'enum NotificationType est fait pour ça.
enum NotificationType {
  APPOINTMENT_REMINDER
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  title  String           @db.VarChar(120)
  body   String           @db.VarChar(500)
  // Entité source optionnelle (ex: appointmentId) — sert d'anti-doublon
  // structurel via @@unique (un même RDV ne produit jamais 2 rappels InApp,
  // même si le canal SMS échoue et est retenté) et de contexte de navigation.
  entityId String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Anti-doublon : (user, type, entité source) unique. NB Postgres : les NULL
  // sont distincts dans un index unique → la déduplication ne vaut que pour
  // les types portant une entityId (cas du rappel RDV).
  @@unique([userId, type, entityId])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ——— FEATURE-TOKENS (ADR-007) — Grille tarifaire configurable par l'ADMIN ———
// Une ligne par poste tarifaire (clé métier → prix en Tokens). Le Médecin
// Chef édite les prix depuis son dashboard ; le coût d'un RDV est FIGÉ à la
// création (appointments.tokensReserved) : modifier un tarif ne vaut que
// pour les demandes à venir. Design extensible — une future ligne (frais
// patient absent, majoration nuit/week-end…) = un INSERT, sans migration.
// Clés v1 : CONSULTATION_CABINET · CONSULTATION_DOMICILE (libellés FR et
// garde-fous 0..100 Tokens : src/lib/token-schemas.ts, source unique).
model TariffConfig {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(60)
  tokens      Int
  // Dernier ADMIN ayant modifié ce tarif (audit) — SetNull : la ligne
  // survit à une suppression éventuelle du compte.
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tariff_configs")
}
