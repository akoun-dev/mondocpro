# =============================================================================
# mondocpro — Variables d'environnement (MODÈLE)
# =============================================================================
#
# CONFIGURATION LOCALE (votre machine) :
#   1. Copier ce fichier :            cp .env.example .env
#   2. Remplacer chaque <PLACEHOLDER> par vos valeurs Supabase :
#        - PROJECT_REF       → Dashboard Supabase → Settings → General → Reference ID
#        - MOT_DE_PASSE_DB   → défini à la création du projet
#                              (réinitialisable : Settings → Database → Reset password)
#        - Clés API          → Dashboard → Settings → API (Data API section)
#   3. Installer et pousser le schéma :  bun install && bun run db:push
#   4. Lancer le serveur :               bun run dev
#
# ⚠️  SÉCURITÉ — CE FICHIER EST VERSIONNÉ :
#     • Ne JAMAIS y écrire un secret réel (mot de passe DB, clés JWT, tokens).
#     • Le fichier `.env` (vrais secrets) est ignoré par git (`.gitignore` → `.env*`).
#     • Politique secrets : voir .ai/SECURITY_AUDIT.md (SEC-ADV-001, SEC-ADV-002).
# =============================================================================


# -----------------------------------------------------------------------------
# Base de données — Supabase PostgreSQL (via Prisma)
# -----------------------------------------------------------------------------
# Connexion via le POOLER Supavisor (recommandée : compatible IPv4, accepte
# l'app ET les migrations). Format exact :
#
#   postgresql://postgres.<PROJECT_REF>:<MOT_DE_PASSE_DB>@aws-1-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
#
#   • <PROJECT_REF>     : Reference ID du projet (Settings → General)
#   • <MOT_DE_PASSE_DB> : mot de passe PostgreSQL du projet
#   • <REGION>          : région de votre pooler, visible dans la chaîne de
#                         connexion du Dashboard (section "Connection pooling").
#                         Format type : aws-1-eu-west-1
#
# Port 5432 = session mode (par défaut). Pour un déploiement serverless,
# Supabase propose aussi le port 6543 (transaction mode, avec &pgbouncer=true).
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<MOT_DE_PASSE_DB>@aws-1-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"

# Alternative : connexion DIRECTE au host de la base (nécessite IPv6 sur votre
# réseau, ou l'add-on IPv4 Supabase). Utile ponctuellement pour `prisma migrate` :
# DATABASE_URL="postgresql://postgres:<MOT_DE_PASSE_DB>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require"


# -----------------------------------------------------------------------------
# Supabase — Data API (Dashboard → Settings → API)
# -----------------------------------------------------------------------------
# URL publique du projet (ex. https://<PROJECT_REF>.supabase.co).
# Préfixe NEXT_PUBLIC_ = exposée au navigateur par design (aucun secret ici).
NEXT_PUBLIC_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"

# Clé publishable (nouveau format `sb_publishable_...`) — côté client,
# protégée par le Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<SB_PUBLISHABLE_KEY>"

# Clé anon (format JWT historique) — côté client, protégée par le RLS.
# (Sert aussi d'en-tête `apikey` pour les appels REST/Storage/Auth.)
NEXT_PUBLIC_SUPABASE_ANON_KEY="<JWT_ANON_KEY>"

# -----------------------------------------------------------------------------
# ⚠️  SECRET SERVEUR UNIQUEMENT — contourne le RLS !
# -----------------------------------------------------------------------------
# Ne JAMAIS préfixer cette variable avec NEXT_PUBLIC_ (elle finirait dans le
# bundle client). À utiliser uniquement dans les API routes / code serveur.
SUPABASE_SERVICE_ROLE_KEY="<JWT_SERVICE_ROLE>"

# -----------------------------------------------------------------------------
# Compte Médecin Chef (seed) — .zscripts/seed_admin.ts
# -----------------------------------------------------------------------------
# Mot de passe initial du compte ADMIN (Dr Kadjane) créé par le seed.
# ⚠️ À CHANGER à la première connexion (itération "changement de mot de passe"
# à venir) — ne versionner que le placeholder ici.
ADMIN_INITIAL_PASSWORD="<MOT_DE_PASSE_ADMIN_INITIAL>"
