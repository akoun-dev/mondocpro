// Schéma MondocPro — FEATURE-AUTH (ADR-004)
// Identifiant métier = téléphone (unique) · sessions serveur en DB (traçabilité)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Rôles applicatifs — miroir des acteurs du cahier des charges
enum Role {
  PATIENT
  INFIRMIER
  ADMIN
}

// Zones de couverture (liste fermée définie par le PO)
enum Zone {
  YOPOUGON
  SONGON
  PK22
  NDOTRE
}

model User {
  id                  String               @id @default(cuid())
  fullName            String
  phone               String               @unique
  passwordHash        String
  role                Role                 @default(PATIENT)
  zone                Zone
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// Jetons de réinitialisation de mot de passe (US-AUTH-5).
// Seul le SHA-256 du code à 6 chiffres est stocké (même principe que les sessions) :
// expiration 15 min, usage unique (usedAt), anciens jetons purgés à chaque demande.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}
